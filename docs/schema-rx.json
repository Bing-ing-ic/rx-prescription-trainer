{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "医学生处方推演训练平台·处方 JSON Schema",
  "version": "2026.11",
  "description": "分两套正文：outpatient_normal（非输液）与 outpatient_iv（输液）。前记/后记共用。",
  "type": "object",
  "required": ["prescription_id", "rx_type", "visit_id", "header", "items", "footer", "timestamp"],
  "properties": {
    "prescription_id": {
      "type": "string",
      "description": "处方编号。输液处方必须以 IV- 开头；格式 科室代码-YYYYMMDD-6位流水号。",
      "pattern": "^(IV-)?[A-Z]{2,4}-\\d{8}-\\d{6}$"
    },
    "rx_type": {
      "type": "string",
      "enum": ["outpatient_normal", "outpatient_iv"]
    },
    "visit_id": {
      "type": "string",
      "description": "一次就诊 ID。同一 visit 下可同时存在 normal 与 iv 两张处方，用于跨通道合并点评。",
      "pattern": "^V-\\d{8}-\\d{6}$"
    },
    "header": {
      "type": "object",
      "description": "处方前记",
      "required": ["hospital", "patient_name", "gender", "age_years", "weight_kg", "id_masked", " outpatient_no", "dept", "diagnosis", "rx_date", "insurance_type"],
      "properties": {
        "hospital": {"type": "string", "const": "微光医院"},
        "patient_name": {"type": "string", "example": ["张三", "李四", "患儿王某"]},
        "gender": {"type": "string", "enum": ["男", "女"]},
        "age_years": {"type": "number", "minimum": 0, "maximum": 120, "description": "实足年龄"},
        "weight_kg": {"type": "number", "minimum": 1, "maximum": 200, "description": "儿童/老人/输液必填"},
        "id_masked": {"type": "string", "pattern": "^\\d{6}\\*+\\d{4}$", "example": "5301**********0011"},
        "outpatient_no": {"type": "string", "example": "MZ20261102001"},
        "dept": {"type": "string", "example": "全科医学科/呼吸内科/消化内科"},
        "diagnosis": {"type": "string"},
        "diagnosis_code": {"type": "string", "description": "ICD-10"},
        "rx_date": {"type": "string", "format": "date"},
        "insurance_type": {"type": "string", "enum": ["城镇职工医保", "城乡居民医保", "自费", "公疗"]}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "处方正文。每张处方≤5种，溶媒计入。",
      "items": {
        "type": "object",
        "required": ["line_no", "generic_name", "dosage_form", "spec", "quantity", "route", "frequency", "duration_days"]
      }
    },
    "footer": {
      "type": "object",
      "description": "处方后记",
      "required": ["prescriber_sign", "reviewer_pharmacist_sign"],
      "properties": {
        "prescriber_sign": {"type": "string", "description": "医师签名"},
        "prescriber_title": {"type": "string", "enum": ["住院医师", "主治医师", "副主任医师", "主任医师"]},
        "reviewer_pharmacist_sign": {"type": "string", "description": "审核药师签名"},
        "dispenser_sign": {"type": "string", "description": "调配药师签名，输液处方必填"},
        "checker_sign": {"type": "string", "description": "核对药师签名，输液处方必填（双签名）"},
        "total_amount": {"type": "number", "minimum": 0},
        "insurance_paid": {"type": "number", "minimum": 0},
        "self_paid": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"_rx_type": {"const": "outpatient_iv"}}},
          "then": {"required": ["dispenser_sign", "checker_sign"]}
        }
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"}
  },

  "definitions": {
    "NormalRxItem": {
      "type": "object",
      "description": "非输液处方正文行",
      "required": ["line_no", "generic_name", "dosage_form", "spec", "quantity", "single_dose", "route", "frequency", "duration_days"],
      "properties": {
        "line_no": {"type": "integer", "minimum": 1},
        "generic_name": {"type": "string"},
        "dosage_form": {"type": "string", "enum": ["oral", "topical", "im", "sc"]},
        "spec": {"type": "string"},
        "quantity": {"type": "number", "minimum": 0.5},
        "single_dose": {"type": "string", "example": "0.5g"},
        "route": {"type": "string", "enum": ["oral", "sublingual", "topical", "im", "sc"]},
        "frequency": {"type": "string", "example": ["qd", "bid", "tid", "q6h"]},
        "duration_days": {"type": "number", "minimum": 1, "maximum": 30}
      }
    },
    "IvRxItem": {
      "type": "object",
      "description": "输液处方正文行。第一行必须是 solvent，后续行为 iv_drip 药物。",
      "required": [
        "line_no", "generic_name", "dosage_form", "spec", "quantity", "route",
        "iv_reason", "solvent_name", "solvent_spec", "solvent_volume_ml",
        "final_concentration", "drip_speed_mlh", "total_volume_ml",
        "infusion_hours", "skin_test_required", "skin_test_result"
      ],
      "properties": {
        "line_no": {"type": "integer", "minimum": 1},
        "generic_name": {"type": "string"},
        "dosage_form": {"type": "string", "enum": ["solvent", "iv_drip"]},
        "spec": {"type": "string"},
        "quantity": {"type": "number", "minimum": 1},
        "route": {"type": "string", "enum": ["iv_drip"]},
        "iv_reason": {
          "type": "string",
          "enum": [
            "heavy_infection_fast_blood_conc",
            "vomiting_diarrhea_dehydration",
            "no_oral_alternative",
            "sequential_therapy",
            "other_with_note"
          ],
          "description": "严禁将'患者要求'作为独立选项。other_with_note 必须配合 iv_reason_note。"
        },
        "iv_reason_note": {"type": "string", "description": "当 iv_reason=other_with_note 时必填"},
        "solvent_name": {"type": "string", "example": "0.9%氯化钠注射液"},
        "solvent_spec": {"type": "string", "example": "250ml/袋"},
        "solvent_volume_ml": {"type": "number", "minimum": 50, "maximum": 1000},
        "final_concentration": {"type": "string", "example": ["0.9%", "2.25mg/ml"]},
        "drip_speed_mlh": {"type": "number", "minimum": 10, "maximum": 200},
        "total_volume_ml": {"type": "number", "minimum": 50, "maximum": 1500},
        "infusion_hours": {"type": "number", "minimum": 0.25, "maximum": 24},
        "skin_test_required": {"type": "boolean"},
        "skin_test_result": {
          "type": "string",
          "enum": ["positive", "negative", "not_required"]
        }
      }
    }
  },

  "examples": [
    {
      "prescription_id": "IV-HX-20261102-000123",
      "rx_type": "outpatient_iv",
      "visit_id": "V-20261102-000007",
      "header": {
        "hospital": "微光医院",
        "patient_name": "王五",
        "gender": "男",
        "age_years": 45,
        "weight_kg": 68,
        "id_masked": "5301**********0011",
        "outpatient_no": "MZ20261102007",
        "dept": "呼吸内科",
        "diagnosis": "社区获得性肺炎",
        "diagnosis_code": "J18.x00",
        "rx_date": "2026-11-02",
        "insurance_type": "城镇职工医保"
      },
      "items": [
        {
          "line_no": 1,
          "generic_name": "0.9%氯化钠注射液",
          "dosage_form": "solvent",
          "spec": "250ml/袋",
          "quantity": 1,
          "route": "iv_drip",
          "iv_reason": "heavy_infection_fast_blood_conc",
          "solvent_name": "0.9%氯化钠注射液",
          "solvent_spec": "250ml/袋",
          "solvent_volume_ml": 250,
          "final_concentration": "6mg/ml",
          "drip_speed_mlh": 40,
          "total_volume_ml": 250,
          "infusion_hours": 1.5,
          "skin_test_required": true,
          "skin_test_result": "negative"
        },
        {
          "line_no": 2,
          "generic_name": "注射用头孢呋辛钠",
          "dosage_form": "iv_drip",
          "spec": "1.5g/支",
          "quantity": 1,
          "route": "iv_drip",
          "frequency": "bid",
          "duration_days": 1,
          "iv_reason": "heavy_infection_fast_blood_conc",
          "solvent_name": "0.9%氯化钠注射液",
          "solvent_spec": "250ml/袋",
          "solvent_volume_ml": 250,
          "final_concentration": "6mg/ml",
          "drip_speed_mlh": 40,
          "total_volume_ml": 250,
          "infusion_hours": 1.5,
          "skin_test_required": true,
          "skin_test_result": "negative"
        }
      ],
      "footer": {
        "prescriber_sign": "李四",
        "prescriber_title": "主治医师",
        "reviewer_pharmacist_sign": "赵六",
        "dispenser_sign": "钱七",
        "checker_sign": "孙八",
        "total_amount": 85.5,
        "insurance_paid": 68.4,
        "self_paid": 17.1
      },
      "timestamp": "2026-11-02T10:23:00+08:00"
    }
  ]
}
